# Replace every placeholder before starting the backend.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_SECONDS=2592000

MYSQL_DATABASE=spending_support
MYSQL_USER=spending_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DATABASE_URL=mysql+pymysql://spending_app:replace-with-a-strong-database-password@mysql:3306/spending_support

ALLOWED_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=2097152
MODEL_ROOT=/app/artifacts/models
FORECAST_MODEL_VERSION=v1
ANOMALY_MODEL_VERSION=v1
LOAD_MODELS=true
# Use lightweight on a 512 MB free web service; full loads TensorFlow + LSTM.
MODEL_RUNTIME=full

# 0 disables automatic retention eligibility. Set a positive number of days,
# then schedule `flask --app backend.run:app purge-retained-data --apply`.
DATA_RETENTION_DAYS=0

# Protects /admin and /api/v1/admin/overview. Always use HTTPS in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Web OAuth 2.0 client ID used to verify Google ID tokens from Android.
GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com

# Used only by backend/seed.py.
SAMPLE_USER_PASSWORD=replace-with-a-development-demo-password
