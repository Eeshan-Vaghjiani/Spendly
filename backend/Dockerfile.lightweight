FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    MODEL_RUNTIME=lightweight \
    SELECTED_MODEL_ROOT=/app/artifacts/candidates/selected_v6

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-light.txt /app/backend/requirements-light.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /app/backend/requirements-light.txt

COPY backend /app/backend
COPY services /app/services
COPY artifacts /app/artifacts

RUN chmod +x /app/backend/start.sh

EXPOSE 10000
CMD ["/app/backend/start.sh"]
